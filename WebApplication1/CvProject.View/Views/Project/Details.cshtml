@model CvProject.View.Models.ViewModels.ProjectDetailsViewModel

@{
    ViewData["Title"] = "Projekt";
}

<div class="card shadow-sm bg-light">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
            <div>
                <h1 class="mb-1">@Model.Title</h1>
                <div class="text-muted">
                    Skapad av <strong>@Model.CreatorName</strong>
                    <span class="mx-2">•</span>
                    @Model.CreatedDate.ToString("yyyy-MM-dd HH:mm")
                </div>
                @Model.Description
            </div>
        </div>
        <hr class="my-4" />

        <h3 class="mb-3">Medlemmar</h3>

@if (Model.Members == null || Model.Members.Count == 0)
{
    <p>Inga medlemmar ännu.</p>
}
else
{
            <div class="list-group">
                @foreach (var m in Model.Members)
                {
                    if (!Model.IsSignedIn && m.IsPrivate)
                    {
                        continue;
                    }

                    <div class="list-group-item d-flex justify-content-between align-items-center">
                        <span>@m.Name</span>

                        @if (Model.IsLeader)
                        {
                            <form asp-controller="Project"
                                  asp-action="RemoveMember"
                                  method="post"
                                  class="m-0">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@Model.Id" />
                                <input type="hidden" name="userId" value="@m.UserId" />
                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                    Ta bort
                                </button>
                            </form>
                        }
                    </div>
                }
            </div>
}

@if (!Model.IsSignedIn)
{
         <p class="text-muted  mt-3 mb-0">Logga in för att se medlemmar med privat profil.</p>
}
@if (Model.IsLeader)
{
            <hr class ="my-4" />
            <h3 class="mb-3">Lägg till medlem</h3>

    @if (Model.AddableUsers == null || Model.AddableUsers.Count == 0)
    {
        <p>Inga fler användare att lägga till.</p>
    }
    else
    {
        <form asp-controller="Project" asp-action="AddMember" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.Id" />

              <select name="userId" class="form-select" style="max-width: 320px;">
                @foreach (var u in Model.AddableUsers)
                {
                    <option value="@u.UserId">@u.Name</option>
                }
            </select>
                    <div class="d-flex flex-wrap gap-2 mt-4">
                        <button type="submit" class="btn btn-success btn-sm" ">Lägg till</button>
                        <a asp-controller="Project"
                           asp-action="Index"
                           class="btn btn-secondary btn-sm">
                            Tillbaka
                        </a>
                        </div>
        </form>
    }
}
