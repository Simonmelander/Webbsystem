@model List<CvProject.Models.Project>

@{
    ViewData["Title"] = "Projektlista";
}

<h2>Alla projekt</h2>

<p>
    <a asp-controller="Project" asp-action="Create">Skapa nytt projekt</a>
</p>

@if (Model == null || !Model.Any())
{
    <p>Inga projekt hittades.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Titel</th>
                <th>Skapad</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in Model)
            {
                <tr>
                    <td>@p.Title</td>
                    <td>@p.CreatedDate.ToString("yyyy-MM-dd HH:mm")</td>
                    <td>
                        <a asp-controller="Project" asp-action="Edit" asp-route-id="@p.Id">Redigera</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
