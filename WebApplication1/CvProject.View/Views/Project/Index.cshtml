@model List<CvProject.Models.Project>
@using Microsoft.AspNetCore.Identity
@using CvProject.Models
@inject UserManager<User> UserManager

@{
    ViewData["Title"] = "Projektlista";
    var currentUserId = UserManager.GetUserId(User);
}

<h2>Alla projekt</h2>

<p>
    <a asp-controller="Project"
       asp-action="Create"
       class="btn btn-primary">
        Skapa nytt projekt
    </a>
</p>


@if (Model == null || !Model.Any())
{
    <p>Inga projekt hittades.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Titel</th>
                <th>Skapad av</th>
                <th>Skapad</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in Model)
            {
                <tr>
                    <td>
                        <a asp-controller="Project" asp-action="Details" asp-route-id="@p.Id">
                            @p.Title
                        </a>
                    </td>

                    <td>
                        @(p.Creator != null ? p.Creator.Name : "Okänd")
                    </td>

                    <td>
                        @p.CreatedDate.ToString("yyyy-MM-dd HH:mm")
                    </td>

                    <td>
                        @if (!string.IsNullOrWhiteSpace(currentUserId) && p.CreatorId == currentUserId)
                        {
                            <a asp-controller="Project" asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-outline-secondary">
                                Redigera
                            </a>
                        }


                        <form asp-controller="Project"
                              asp-action="Join"
                              asp-route-id="@p.Id"
                              method="post"
                              style="display:inline;">
                            @Html.AntiForgeryToken()
                            <button type="submit"
                                    class="btn btn-sm btn-primary ms-2">
                                Gå med
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
