@model List<CvProject.Models.Project>
@using Microsoft.AspNetCore.Identity
@using CvProject.Models
@inject UserManager<User> UserManager

@{
    ViewData["Title"] = "Projektlista";
    var currentUserId = UserManager.GetUserId(User);
}

<h1 class="mb-4">Alla projekt</h1>

@if (Model == null || !Model.Any())
{
    <p>Inga projekt hittades.</p>
}
else
{
    <div class="card shadow-sm bg-light">
    <div class="card-body">
            <table class="table table-borderless mb-0 bg-light">
                <thead>
                    <tr>
                        <th class="fs-5">Titel</th>
                        <th class="fs-5">Skapad av</th>
                        <th class="fs-5">Skapad</th>
                        <th></th>
                    </tr>
                </thead>
        <tbody>
            @foreach (var p in Model)
            {
                <tr>
                    <td>
                                <a asp-controller="Project"
                                   asp-action="Details"
                                   asp-route-id="@p.Id"
                                   class="link-info text-decoration-none fw-semibold">
                                    @p.Title
                                </a>
                    </td>

                    <td>
                        @(p.Creator != null ? p.Creator.Name : "Okänd")
                    </td>

                    <td>
                        @p.CreatedDate.ToString("yyyy-MM-dd HH:mm")
                            </td>
                            <td>
                                <div class="d-flex flex-nowrap align-items-center gap-2">
                                    @if (!string.IsNullOrWhiteSpace(currentUserId) && p.CreatorId == currentUserId)
                                    {
                                        <a asp-controller="Project"
                                           asp-action="Edit"
                                           asp-route-id="@p.Id"
                                           class="btn btn-sm btn-outline-primary">
                                            Redigera
                                        </a>
                                    }

                                    <form asp-controller="Project"
                                          asp-action="Join"
                                          asp-route-id="@p.Id"
                                          method="post">
                                        @Html.AntiForgeryToken()
                                        <button type="submit"
                                                class="btn btn-sm btn-primary">
                                            Gå med
                                        </button>
                                    </form>
                                </div>
                            </td>
                </tr>
            }
        </tbody>
    </table>
        </div>
    </div>

    <p class="mt-3">
        <a asp-controller="Project"
           asp-action="Create"
           class="btn btn-success">
            Skapa nytt projekt
        </a>
    </p>
}
