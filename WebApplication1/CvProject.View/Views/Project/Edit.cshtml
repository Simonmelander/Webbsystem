@model CvProject.Models.Project

@{
    ViewData["Title"] = "Redigera Projekt";
}

<h1 class="mb-4">Redigera projekt</h1>


<form asp-controller="Project" asp-action="Edit" method="post">
    @Html.AntiForgeryToken()

    <input type="hidden" asp-for="Id" />

    <div class="mb-3">
        <label asp-for="Title" class="form-label"></label>
        <input asp-for="Title" class="form-control" />
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control" rows="5"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>
</form>

    <div class="d-flex flex-wrap gap-2 mt-4">
        <button type="submit" class="btn btn-success">
            Spara ändringar
        </button>

        <form asp-controller="Project"
              asp-action="Delete"
              asp-route-id="@Model.Id"
              method="post"
              class="m-0"
              onsubmit="return confirm('Är du säker på att du vill radera projektet?');">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-outline-danger">
                Radera projekt
            </button>
        </form>

        <a asp-controller="Project"
           asp-action="Index"
           class="btn btn-secondary">
            Tillbaka
        </a>
    </div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
