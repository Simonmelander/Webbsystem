@model CvProject.View.Models.HomeViewModel

@{
    ViewData["Title"] = "Startsida";
}
<h2>Utvalda CV</h2>

@if (Model.FeaturedCvs == null || !Model.FeaturedCvs.Any())
{
    <p>Inga publika CV hittades.</p>
}

else
{
    <ul>
        @foreach (var cv in Model.FeaturedCvs)
        {
            <li>
                <strong>@(cv.User?.Name ?? "Okänd användare")</strong>
                <span> </span>
                <a asp-controller="Cv" asp-action="Details" asp-route-id="@(cv.Id)">
                    Gå till profil
                </a>
            </li>
        }
    </ul>
}
<hr />

<h2>Senast upplagda projekt</h2>

@if (Model.LatestProject == null)
{
    <p>Inget projekt är upplagt ännu.</p>
}
else
{
    <div>
        <h3>@Model.LatestProject.Title</h3>
        <p>@Model.LatestProject.Description</p>
        <p><em>Skapad: @Model.LatestProject.CreatedDate.ToString("yyyy-MM-dd HH:mm")</em></p>
    </div>
}
