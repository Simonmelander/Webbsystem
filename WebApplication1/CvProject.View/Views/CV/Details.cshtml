@using CvProject.View.Models.CvViewModels
@model CvDetailsViewModel;

@{
    ViewData["Title"] = "CV Details";
}

<div class="container">
    <header class="mb-5">
        <h1>@Model.FullName</h1>
        <p class="lead">Kontakt: <a href="mailto:@Model.Email">@Model.Email</a></p>
    </header>
    </div>

    <div class="row">
        <div class="col-md-6">
            <h3>Utbildning</h3>
            <hr />
            @foreach (var education in Model.Educations)
            {
                <div class="mb-4">
                    <h5>@education.Degree vid @education.School</h5>
                    <p><em>@education.StartDate.ToString("MMMM yyyy") - @(education.EndDate.HasValue? education.EndDate.Value.ToString("MMMM yyyy") : "Present")</em></p>
                    <p>@education.Description</p>
                </div>
            }
        </div>
    </div>

    <div class="row">
        <div class="col-md-6">
            <h3>Erfarenhet</h3>
            <hr />
            @foreach (var experience in Model.Experiences)
            {
                <div class="mb-4">
                    <h5>@experience.Position på @experience.Company</h5>
                    <p><em>@experience.StartDate.ToString("MMMM yyyy") - @(experience.EndDate.HasValue ? experience.EndDate.Value.ToString("MMMM yyyy") : "Present")</em></p>
                    <p>@experience.Description</p>
                </div>
            }
        </div>

        <div class="row">
            <div class="col-md-6">
                <h3>Färdigheter</h3>
                <hr />
                <ul class="list-group">
                    @foreach (var skill in Model.Skills)
                    {
                        <li class="list-group-item">@skill.Name</li>
                    }
                </ul>
            </div>
        </div>
</div>