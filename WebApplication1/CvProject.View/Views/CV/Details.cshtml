@using CvProject.View.Models.CvViewModels
@model CvDetailsViewModel

@{
    ViewData["Title"] = "CV Details";
}

<div class="container py-5">
    <div class="card border-0 shadow-sm mb-5">
        <div class="card-body p-4 p-md-5">
            <div class="row align-items-center">
                <div class="col-md-3 text-center mb-4 mb-md-0">
                    <img src="@Model.ProfilePictureUrl" alt="Profilbild av @Model.FullName"
                         class="img-fluid rounded-circle shadow"
                         style="width: 180px; height: 180px; object-fit: cover; border: 5px solid #fff;" />
                </div>
                <div class="col-md-6 text-center text-md-start">
                    <h1 class="display-4 fw-bold">@Model.FullName</h1>
                    <p class="lead text-muted"><i class="bi bi-envelope"></i> @Model.Email</p>

                    @if (Model.IsOwner)
                    {
                        <a asp-controller="Cv" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary mt-3">Redigera mitt CV</a>
                        <p class="mt-2">Antal visningar: <strong>@Model.VisitCount</strong></p>
                    }
                </div>

                @if (!Model.IsOwner)
                {
                    <div class="col-md-3 mt-4 mt-md-0">
                        <div class="card bg-light border-0 shadow-sm">
                            <div class="card-body">
                                <h5 class="card-title">Kontakta @Model.FullName</h5>
                                <form asp-controller="Message" asp-action="Send" method="post">
                                    @if (!User.Identity.IsAuthenticated)
                                    {
                                        <div class="mb-3">
                                            <input type="text" name="anonymousName" class="form-control mb-2" placeholder="Ditt namn" required />
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="mb-3">
                                            <input type="text" name="anonymousName" class="form-control mb-2" value="@User.Identity.Name" disabled />
                                        </div>
                                    }
                                    <div class="mb-3">
                                        <input type="text" name="subject" class="form-control mb-2" placeholder="Ämne" required />
                                    </div>
                                    <div class="mb-3">
                                        <textarea name="body" class="form-control mb-2" rows="3" placeholder="Skriv ditt meddelande här..." required></textarea>
                                    </div>
                                    <input type="hidden" name="receiverId" value="@Model.User.Id" />
                                    <input type="hidden" name="anonymousName" value="Anonym" />
                                    <button type="submit" class="btn btn-primary btn-sm w-100 mt-1">Skicka</button>
                                </form>
                            </div>
                        </div>
                    </div>
                }

                <div class="mt-4">
                    <h5 class="text-muted small text-uppercase fw-bold mb-3">Färdigheter</h5>
                    <div class="d-flex flex-wrap gap-2">
                        @foreach (var skill in Model.Skills)
                        {
                            <span class="badge bg-primary fs-6 shadow-sm">@skill.Name</span>
                        }
                    </div>
                </div>

                <div class="row mt-5">
                    <div class="col-lg-8">
                        <div class="card shadow-sm bg-light mb-5">
                            <div class="card-body">
                                <h2 class="fw-bold mb-4">Erfarenhet</h2>
                            @foreach (var experience in Model.Experiences)
                            {
                                <div class="card border-0 mb-3 shadow-sm">
                                    <div class="card-body">
                                        <div class="d-flex justify-content-between align-items-start">
                                            <h5 class="fw-bold text-dark mb-1">@experience.Position</h5>
                                            <span class="text-muted fw-medium">
                                                @experience.StartDate.ToString("MMM yyyy") - @(experience.EndDate.HasValue? experience.EndDate.Value.ToString("MMM yyyy") : "Nuvarande")
                                            </span>
                                        </div>
                                        <h6 class="text-muted mb-2">@experience.Company</h6>
                                        <p class="card-text text-secondary">@experience.Description</p>
                                    </div>
                                </div>
                            }
                    </div>
                </div>

                <div class="row">
                            <div class="col-lg-8">
                                <div class="card shadow-sm bg-light mb-5">
                                    <div class="card-body">
                                        <h2 class="fw-bold mb-4">Utbildning</h2>

                            @foreach (var education in Model.Educations)
                            {
                                <div class="card border-0 mb-3 shadow-sm">
                                    <div class="card-body">
                                        <div class="d-flex justify-content-between align-items-start">
                                            <h5 class="fw-bold text-dark mb-1">@education.Degree, @education.FieldOfStudy</h5>
                                            <span class="text-muted fw-medium">
                                                @education.StartDate.ToString("MMM yyyy") - @(education.EndDate.HasValue? education.EndDate.Value.ToString("MMM yyyy") : "Nuvarande")
                                            </span>
                                        </div>
                                        <h6 class="text-muted mb-2">@education.School</h6>
                                        <p class="card-text text-secondary">@education.Description</p>
                                    </div>
                                </div>
                            }
                    </div>
                </div>

                <div class="row">
                    <div class="col-lg-8">
                            <div class="card shadow-sm bg-light mb-5">
                            <div class="card-body">
                            <h2 class="fw-bold mb-4">Projekt</h2>
                            @if (!Model.Projects.Any())
                            {
                                <p class="text-secondary">Inga projekt att visa.</p>
                            }
                            @foreach (var project in Model.Projects)
                            {
                                <div class="card border-0 mb-3 shadow-sm">
                                    <div class="card-body">
                                        <h5 class="fw-bold text-dark mb-2">@project.Title</h5>
                                        <p class="card-text text-secondary">@project.Description</p>
                                    </div>
                                </div>
                            }
                    </div>
                </div>

                @if (Model.SimilarCvProfiles != null && Model.SimilarCvProfiles.Any())
                {
                    <div class="row mt-5 pt-4 border-top">
                        <div class="col-lg-12">
                            <h3 class="fw-bold mb-3">Liknande profiler</h3>
                            <p class="text-muted mb-4">Personer med liknande kompetenser</p>

                            <div class="row">
                                @foreach (var person in Model.SimilarCvProfiles)
                                {
                                    <div class="col-md-4 mb-3">
                                        <div class="card h-100 border-0 shadow-sm text-center p-3">
                                            <div class="card-body">
                                                <img src="@(string.IsNullOrEmpty(person.ProfilePictureUrl) ? "https://as1.ftcdn.net/jpg/00/57/04/58/1000_F_57045887_HHJml6DJVxNBMqMeDqVJ0ZQDnotp5rGD.jpg" : person.ProfilePictureUrl)"
                                                     class="rounded-circle mb-3 shadow-sm"
                                                     style="width: 80px; height: 80px; object-fit: cover;"
                                                     alt="@person.FullName" />

                                                <h5 class="card-title fw-bold text-primary">@person.FullName</h5>

                                                <div class="mb-3">
                                                    <span class="badge bg-success">
                                                        @person.MatchingSkillsCount gemensamma skills
                                                    </span>
                                                </div>

                                                <a asp-controller="Cv" asp-action="Details" asp-route-id="@person.CvId"
                                                   class="btn btn-outline-primary btn-sm w-100 stretched-link">
                                                    Besök Profil
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }

            </div>
        </div>
    </div>
</div>