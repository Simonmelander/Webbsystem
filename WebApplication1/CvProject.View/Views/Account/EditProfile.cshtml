@model CvProject.View.Models.EditProfileViewModel

@{
    ViewData["Title"] = "Ändra Profil";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h3 class="card-title mb-0">Redigera Profil</h3>
                </div>
                <div class="card-body">
                    <form asp-action="EditProfile" method="post">

                        <h5 class="mb-3 border-bottom pb-2">Personuppgifter</h5>

                        <div class="mb-3">
                            <label asp-for="Name" class="form-label"></label>
                            <input asp-for="Name" class="form-control" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label"></label>
                            <input asp-for="Email" class="form-control" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Address" class="form-label"></label>
                            <input asp-for="Address" class="form-control" />
                            <span asp-validation-for="Address" class="text-danger"></span>
                        </div>

                        <div class="mb-3 form-check">
                            <input asp-for="IsPrivate" class="form-check-input" />
                            <label asp-for="IsPrivate" class="form-check-label"></label>
                        </div>

                        <h5 class="mt-4 mb-3 border-bottom pb-2">Byt Lösenord (frivilligt)</h5>

                        <div class="mb-3">
                            <label asp-for="CurrentPassword" class="form-label"></label>
                            <input asp-for="CurrentPassword" class="form-control" placeholder="Lämna tomt om du inte vill byta" />
                            <span asp-validation-for="CurrentPassword" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="NewPassword" class="form-label"></label>
                            <input asp-for="NewPassword" class="form-control" />
                            <span asp-validation-for="NewPassword" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ConfirmNewPassword" class="form-label"></label>
                            <input asp-for="ConfirmNewPassword" class="form-control" />
                            <span asp-validation-for="ConfirmNewPassword" class="text-danger"></span>
                        </div>
                        <h5 class="mt-4 mb-3 border-bottom pb-2">Projekt jag ingår i</h5>

                        @if (Model.AllProjects == null || !Model.AllProjects.Any())
                        {
                            <p>Inga projekt finns ännu.</p>
                        }
                        else
                        {
                            @for (int i = 0; i < Model.AllProjects.Count; i++)
                            {
                                <div class="form-check">
                                    <input type="hidden" asp-for="AllProjects[i].ProjectId" />
                                    <input type="hidden" asp-for="AllProjects[i].Title" />

                                    <input asp-for="AllProjects[i].IsSelected" class="form-check-input" />
                                    <label class="form-check-label">
                                        @Model.AllProjects[i].Title
                                    </label>
                                </div>
                            }
                        }

                        <div class="d-grid gap-2 mt-4">
                            <button type="submit" class="btn btn-success btn-lg">Spara ändringar</button>
                            <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">Avbryt</a>
                        </div>

                        <div asp-validation-summary="ModelOnly" class="text-danger mt-3"></div>

                    </form>
                </div>
            </div>
            <hr class="my-5" />

            <div class="card border-danger">
                <div class="card-header bg-danger text-white">
                    Avsluta konto
                </div>
                <div class="card-body">
                    <p class="text-danger">
                        <strong>Varning:</strong> Om du avslutar ditt konto kommer din profil inte längre synas för andra användare.
                    </p>

                    <form asp-action="DeactivateAccount" method="post" onsubmit="return confirm('Är du säker på att du vill avsluta ditt konto?');">
                        <button type="submit" class="btn btn-outline-danger w-100">
                            Avsluta mitt konto
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}